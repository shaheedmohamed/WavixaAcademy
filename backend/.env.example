APP_NAME="Wavixa Academy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://academy.wavixa.net
APP_FRONTEND_URL=https://academy.wavixa.net

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wavixa_academy
DB_USERNAME=wavixa_academy
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=academy.wavixa.net
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Sanctum SPA auth — must list the frontend origin host(s)
SANCTUM_STATEFUL_DOMAINS=academy.wavixa.net

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="academy@wavixa.net"
MAIL_FROM_NAME="${APP_NAME}"

# ── Google Drive (source video library) ─────────────────────────────
# Service-account credentials. Create in Google Cloud Console, enable
# Drive API, share the source Drive folder with the client_email.
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_PRIVATE_KEY_ID=
GOOGLE_DRIVE_PROJECT_ID=
# Optional API key for public-file metadata lookups
GOOGLE_DRIVE_API_KEY=

# ── Video provider (protected playback) ─────────────────────────────
VIDEO_PROVIDER=mux
# Mux API token (Video > Settings > API Access Tokens)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Mux signing key (Video > Settings > Signing Keys) — PEM private key
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE_KEY=
# Mux webhook signing secret for /api/webhooks/mux
MUX_WEBHOOK_SECRET=
# signed | public (use signed in production)
MUX_PLAYBACK_POLICY=signed

# ── CourseShield (video security) ───────────────────────────────────
VIDEO_SESSION_TTL_MINUTES=120
VIDEO_HEARTBEAT_INTERVAL_SECONDS=30
VIDEO_COMPLETION_THRESHOLD=0.9
VIDEO_MAX_DEVICES=3
VIDEO_MAX_CONCURRENT_SESSIONS=1
# terminate_oldest | block_new | alert
VIDEO_CONCURRENT_POLICY=terminate_oldest
VIDEO_WATERMARK_ENABLED=true
VIDEO_WATERMARK_INTERVAL_SECONDS=45

# Enrollment default validity (days); null/empty = lifetime
ENROLLMENT_DEFAULT_EXPIRY_DAYS=

VITE_APP_NAME="${APP_NAME}"

# Wavixa WhatsApp notifications (official Meta API hosted on wavixa.net)
WAVIXA_API_URL=https://wavixa.net/api
WAVIXA_API_KEY=
# Approved Meta template name — fallback for cold users (24h window closed)
WAVIXA_WA_TEMPLATE=
